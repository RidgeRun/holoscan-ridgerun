{
  "$schema": "urn:holohub:operator:v1",
  "operator": {
    "name": "argus_camera",
    "authors": [{"name": "RidgeRun", "affiliation": "RidgeRun, LLC"}],
    "description": "Capture a directly attached Jetson CSI camera through Argus EGLStream into a CUDA BGRA tensor without an NV12 staging copy",
    "language": ["C++"],
    "version": "0.1.0",
    "changelog": {"0.1.0": "Initial Holoscan SDK (HSDK) 5 implementation"},
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["aarch64"],
    "tags": ["Argus", "Camera", "CUDA", "CSI", "Jetson"],
    "ranking": 2,
    "requirements": {
      "hardware": [
        {
          "name": "Jetson CSI camera",
          "description": "An Argus-compatible MIPI CSI-2 camera connected directly to a Jetson camera connector",
          "required": true
        }
      ],
      "libraries": [
        {"name": "CUDA Toolkit", "required": true},
        {"name": "Jetson Multimedia API / libArgus", "required": true}
      ]
    }
  }
}
