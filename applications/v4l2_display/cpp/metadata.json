{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "v4l2_display",
    "authors": [
      {
        "name": "RidgeRun",
        "affiliation": "RidgeRun, LLC"
      }
    ],
    "description": "HSDK 5 V4L2 RG10 capture, CUDA Bayer processing, and DRM/KMS display",
    "language": "C++",
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Initial minimal V4L2 to display graph with MMAP and USERPTR capture paths"
    },
    "dockerfile": "applications/v4l2_display/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": [
      "Camera",
      "CUDA",
      "Latency",
      "Visualization"
    ],
    "ranking": 1,
    "requirements": {
      "hardware": [
        {
          "name": "V4L2 camera",
          "description": "An IMX274-compatible V4L2 camera supporting RG10 Bayer at the selected resolution and frame rate",
          "required": true
        },
        {
          "name": "NVIDIA GPU",
          "description": "CUDA-capable GPU supported by HSDK 5.x",
          "required": true
        },
        {
          "name": "DRM/KMS display",
          "description": "A connected DRM/KMS connector accessible through /dev/dri/card*; the process must be DRM master",
          "required": true
        }
      ],
      "operators": [
        {
          "name": "drm_bgra_display",
          "version": "0.1.0"
        },
        {
          "name": "drm_display",
          "version": "0.1.0"
        },
        {
          "name": "raw_bayer_to_bgra",
          "version": "0.1.0"
        },
        {
          "name": "v4l2_source",
          "version": "0.1.0"
        },
        {
          "name": "v4l2_userptr_source",
          "version": "0.1.0"
        }
      ]
    },
    "default_mode": "validate",
    "modes": {
      "live": {
        "description": "Capture RG10 Bayer with MMAP or USERPTR, convert it to BGRA on CUDA, and display through DRM/KMS",
        "build": {
          "docker_build_args": ["--target", "v4l2-display-live"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_display\"",
          "workdir": "holohub_bin"
        }
      },
      "validate": {
        "description": "Compile the minimal graph without opening the camera or DRM device",
        "build": {
          "docker_build_args": ["--target", "v4l2-display-validate"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_display\" --validate",
          "workdir": "holohub_bin"
        }
      }
    }
  }
}
