{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "v4l2_userptr_perf",
    "authors": [{"name": "RidgeRun", "affiliation": "RidgeRun, LLC"}],
    "description": "V4L2 USERPTR IMX274 capture and X11 display with a zero-copy performance pass-through",
    "language": "C++",
    "version": "0.1.0",
    "changelog": {"0.1.0": "Add gst-perf-like FPS, bitrate, and CPU reporting"},
    "dockerfile": "applications/v4l2_userptr_perf/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["aarch64"],
    "tags": ["Benchmarking", "Camera", "CUDA", "V4L2", "Visualization"],
    "ranking": 2,
    "requirements": {
      "hardware": [
        {"name": "IMX274 V4L2 camera", "description": "RG10 V4L2 source", "required": false},
        {"name": "NVIDIA GPU", "description": "CUDA-capable GPU", "required": true},
        {"name": "X11 display", "description": "Accessible X11 display", "required": false}
      ],
      "operators": [
        {"name": "perf_op", "version": "0.1.0"},
        {"name": "raw_bayer_to_bgra", "version": "0.1.0"},
        {"name": "v4l2_userptr_source", "version": "0.1.0"},
        {"name": "x11_display", "version": "0.1.0"}
      ]
    },
    "default_mode": "validate",
    "modes": {
      "live": {
        "description": "Capture, process, report performance, and display",
        "build": {"docker_build_args": ["--target", "v4l2-userptr-perf-live"]},
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_userptr_perf\" --device /dev/video0 --width 1920 --height 1080 --fps 60 --sensor-gain 8000000 --exposure-us 15649 --optical-black 50 --raw-shift 6 --display-gain 12.0 --gamma 2.2 --bayer-grid 1 --bitrate-interval 1000 --bitrate-window-size 0",
          "workdir": "holohub_bin"
        }
      },
      "validate": {
        "description": "Compile the graph without opening camera or display",
        "build": {"docker_build_args": ["--target", "v4l2-userptr-perf-validate"]},
        "run": {"command": "\"<holohub_app_bin>/v4l2_userptr_perf\" --validate", "workdir": "holohub_bin"}
      }
    }
  }
}
