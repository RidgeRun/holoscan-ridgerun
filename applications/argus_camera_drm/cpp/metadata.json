{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "argus_camera_drm",
    "authors": [{"name": "RidgeRun", "affiliation": "RidgeRun, LLC"}],
    "description": "Direct Jetson MIPI CSI capture through Argus EGLStream with CUDA conversion and exclusive DRM/KMS display",
    "language": "C++",
    "version": "0.1.0",
    "changelog": {"0.1.0": "Initial Holoscan SDK (HSDK) 5 implementation"},
    "dockerfile": "applications/argus_camera_drm/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["aarch64"],
    "tags": ["Argus", "Camera", "CUDA", "CSI", "Jetson", "Visualization", "DRM", "KMS"],
    "ranking": 2,
    "requirements": {
      "hardware": [
        {
          "name": "Jetson CSI camera",
          "description": "An Argus-compatible MIPI CSI-2 camera attached directly to the Jetson board",
          "required": true
        },
        {
          "name": "DRM/KMS display",
          "description": "A connected DRM/KMS output available for exclusive display",
          "required": true
        }
      ],
      "operators": [
        {"name": "argus_camera", "version": "0.1.0"},
        {"name": "drm_bgra_display", "version": "0.2.0"},
        {"name": "drm_display", "version": "0.1.0"}
      ]
    },
    "default_mode": "live",
    "modes": {
      "live": {
        "description": "Capture camera 0 sensor mode 0 at 1920x1080 and display through exclusive DRM/KMS",
        "build": {
          "docker_build_args": ["--target", "argus-camera-drm-live"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/argus_camera_drm\" --width 1920 --height 1080 --drm-device /dev/dri/card2 --mode 1920x1080",
          "workdir": "holohub_bin"
        }
      },
      "validate": {
        "description": "Compile the graph without opening the camera or display",
        "build": {
          "docker_build_args": ["--target", "argus-camera-drm-validate"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/argus_camera_drm\" --width 1920 --height 1080 --validate",
          "workdir": "holohub_bin"
        }
      }
    }
  }
}
