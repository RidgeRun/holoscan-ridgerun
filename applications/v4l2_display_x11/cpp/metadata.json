{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "v4l2_display_x11",
    "authors": [
      {
        "name": "RidgeRun",
        "affiliation": "RidgeRun, LLC"
      }
    ],
    "description": "Minimal Holoscan SDK (HSDK) 5 V4L2-to-X11 display graph without inference",
    "language": "C++",
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Initial minimal V4L2 to X11 graph with MMAP and USERPTR capture paths"
    },
    "dockerfile": "applications/v4l2_display_x11/Dockerfile",
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": [
      "Camera",
      "CUDA",
      "Latency",
      "Visualization",
      "X11"
    ],
    "ranking": 1,
    "requirements": {
      "hardware": [
        {
          "name": "V4L2 camera",
          "description": "An IMX274-compatible V4L2 camera supporting RG10 Bayer at the selected resolution and frame rate",
          "required": true
        },
        {
          "name": "NVIDIA GPU",
          "description": "CUDA-capable GPU supported by HSDK 5.x",
          "required": true
        },
        {
          "name": "X11 display",
          "description": "Required for live visualization: an accessible X11 display for the output window",
          "required": false
        }
      ],
      "operators": [
        {
          "name": "v4l2_source",
          "version": "0.1.0"
        },
        {
          "name": "v4l2_userptr_source",
          "version": "0.1.0"
        },
        {
          "name": "x11_display",
          "version": "0.1.0"
        },
        {
          "name": "raw_bayer_to_bgra",
          "version": "0.1.0"
        }
      ]
    },
    "default_mode": "validate",
    "modes": {
      "live": {
        "description": "Capture RG10 Bayer, convert to BGRA on CUDA, and display through an X11 window",
        "build": {
          "docker_build_args": ["--target", "v4l2-display-x11-live"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_display_x11\"",
          "workdir": "holohub_bin"
        }
      },
      "validate": {
        "description": "Compile the minimal graph without opening the camera or X11 display",
        "build": {
          "docker_build_args": ["--target", "v4l2-display-x11-validate"]
        },
        "run": {
          "command": "\"<holohub_app_bin>/v4l2_display_x11\" --validate",
          "workdir": "holohub_bin"
        }
      }
    }
  }
}
